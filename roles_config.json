        "allowed_relations": ["SELF"],
        "note": "confirm whether high ranks should be able to set another user's timezone at all."
      },
      "SET_RANK": {
        "min_rank_order": null,
        "grants": [
          { "allowed_relations": ["LOWER"], "allowed_categories": ["MID-RANK"], "min_rank_order": 7  },
          { "allowed_relations": ["SELF"], "min_rank_order": 14 }
        ],
        "note": "high ranks only. Supply allowed_relations (likely LOWER) and a min_rank_order."
      },
      "SET_BRANCH": {
        "min_rank_order": null,
        "grants": [
          { "allowed_relations": ["LOWER"], "allowed_categories": ["HIGH-RANK"] },
          { "allowed_relations": ["SELF"], "allowed_categories": ["HIGH-RANK"] }
        ],
        "note": "high ranks only. Same shape as SET_RANK."
      },
      "SET_STATUS": {
        "grants": [
          { "allowed_relations": ["SELF"] }
        ],
        "note": "users may set their own allowed status; high ranks may set lower-ranked users'. Fill the first grant with [\"SELF\"] and the second with [\"LOWER\"] to enable that."
      },
      "SET_LOA": {
        "grants": [
          { "allowed_relations": ["SELF"] },
          { "allowed_relations": ["LOWER"], "allowed_categories": ["HIGH-RANK"] }
        ],
        "note": "pending the LOA data format definition. See roles/loa.py."
      },
      "FORCE_SYNC": {
        "min_rank_order": 12,
